# Telegram
BOT_TOKEN=123456:REPLACE_WITH_REAL_TOKEN

# Google Gemini
GEMINI_API_KEY=REPLACE_WITH_REAL_KEY
GEMINI_DEFAULT_MODEL=gemini-flash-lite-latest
GEMINI_ADVANCED_MODEL=gemini-flash-latest

# Database (async driver; Alembic also runs this via an async engine)
DATABASE_URL=postgresql+asyncpg://languagebot:languagebot@postgres:5432/languagebot

# App
LOG_LEVEL=INFO
ENVIRONMENT=development

# Obsidian knowledge-graph vault -- a plain folder of Markdown notes the bot
# manages. Point Obsidian's "Open folder as vault" at this path to browse it.
# In Docker this is the container-side path (bind-mounted from ./obsidian-vault
# on the host by docker-compose.yml); running locally it's just a relative path.
OBSIDIAN_VAULT_PATH=/app/obsidian-vault
